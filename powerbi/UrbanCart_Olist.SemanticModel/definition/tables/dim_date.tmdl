table dim_date
	lineageTag: dim_date-table

	column date_id
		dataType: dateTime
		summarizeBy: none
		sourceColumn: date_id

	column year
		dataType: int64
		summarizeBy: none
		sourceColumn: year

	column month
		dataType: int64
		summarizeBy: none
		sourceColumn: month

	column day
		dataType: int64
		summarizeBy: none
		sourceColumn: day

	column quarter
		dataType: int64
		summarizeBy: none
		sourceColumn: quarter

	column month_start
		dataType: dateTime
		summarizeBy: none
		sourceColumn: month_start

	partition dim_date = m
		mode: import
		source =
			let
				Source = Csv.Document(
					File.Contents(#"Data Folder" & "/dim_date.csv"),
					[Delimiter = ",", Columns = 6, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				),
				#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				#"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {
					{"date_id", DateTime.Type},
				{"year", Int64.Type},
				{"month", Int64.Type},
				{"day", Int64.Type},
				{"quarter", Int64.Type},
				{"month_start", DateTime.Type}
				})
			in
				#"Changed Type"
