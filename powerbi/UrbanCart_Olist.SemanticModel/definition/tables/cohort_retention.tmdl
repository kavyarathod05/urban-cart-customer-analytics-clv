table cohort_retention
	lineageTag: cohort_retention-table

	column cohort_month
		dataType: dateTime
		summarizeBy: none
		sourceColumn: cohort_month

	column period_number
		dataType: int64
		summarizeBy: none
		sourceColumn: period_number

	column cohort_size
		dataType: int64
		summarizeBy: sum
		sourceColumn: cohort_size

	column retained_customers
		dataType: int64
		summarizeBy: sum
		sourceColumn: retained_customers

	column retention_rate
		dataType: double
		summarizeBy: sum
		sourceColumn: retention_rate

	partition cohort_retention = m
		mode: import
		source =
			let
				Source = Csv.Document(
					File.Contents(#"Data Folder" & "/cohort_retention.csv"),
					[Delimiter = ",", Columns = 5, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				),
				#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				#"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {
					{"cohort_month", DateTime.Type},
				{"period_number", Int64.Type},
				{"cohort_size", Int64.Type},
				{"retained_customers", Int64.Type},
				{"retention_rate", Number.Type}
				})
			in
				#"Changed Type"
