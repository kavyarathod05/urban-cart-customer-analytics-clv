table pbi_category_performance
	lineageTag: pbi_category_performance-table

	column category
		dataType: string
		summarizeBy: none
		sourceColumn: category

	column revenue
		dataType: double
		summarizeBy: sum
		sourceColumn: revenue

	column units
		dataType: int64
		summarizeBy: sum
		sourceColumn: units

	column orders
		dataType: int64
		summarizeBy: sum
		sourceColumn: orders

	column customers
		dataType: int64
		summarizeBy: sum
		sourceColumn: customers

	column revenue_per_order
		dataType: double
		summarizeBy: sum
		sourceColumn: revenue_per_order

	partition pbi_category_performance = m
		mode: import
		source =
			let
				Source = Csv.Document(
					File.Contents(#"Data Folder" & "/pbi_category_performance.csv"),
					[Delimiter = ",", Columns = 6, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				),
				#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				#"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {
					{"category", Text.Type},
				{"revenue", Number.Type},
				{"units", Int64.Type},
				{"orders", Int64.Type},
				{"customers", Int64.Type},
				{"revenue_per_order", Number.Type}
				})
			in
				#"Changed Type"
