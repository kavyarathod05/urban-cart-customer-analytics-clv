table pbi_customer_360
	lineageTag: pbi_customer_360-table

	column customer_id
		dataType: string
		summarizeBy: none
		sourceColumn: customer_id

	column signup_date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: signup_date

	column city
		dataType: string
		summarizeBy: none
		sourceColumn: city

	column state
		dataType: string
		summarizeBy: none
		sourceColumn: state

	column total_orders
		dataType: int64
		summarizeBy: sum
		sourceColumn: total_orders

	column total_spent
		dataType: double
		summarizeBy: sum
		sourceColumn: total_spent

	column avg_order_value
		dataType: double
		summarizeBy: sum
		sourceColumn: avg_order_value

	column first_purchase
		dataType: dateTime
		summarizeBy: none
		sourceColumn: first_purchase

	column last_purchase_date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: last_purchase_date

	column lifespan_days
		dataType: int64
		summarizeBy: sum
		sourceColumn: lifespan_days

	column cohort_month
		dataType: dateTime
		summarizeBy: none
		sourceColumn: cohort_month

	column days_inactive
		dataType: int64
		summarizeBy: sum
		sourceColumn: days_inactive

	partition pbi_customer_360 = m
		mode: import
		source =
			let
				Source = Csv.Document(
					File.Contents(#"Data Folder" & "/pbi_customer_360.csv"),
					[Delimiter = ",", Columns = 12, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				),
				#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				#"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {
					{"customer_id", Text.Type},
				{"signup_date", DateTime.Type},
				{"city", Text.Type},
				{"state", Text.Type},
				{"total_orders", Int64.Type},
				{"total_spent", Number.Type},
				{"avg_order_value", Number.Type},
				{"first_purchase", DateTime.Type},
				{"last_purchase_date", DateTime.Type},
				{"lifespan_days", Int64.Type},
				{"cohort_month", DateTime.Type},
				{"days_inactive", Int64.Type}
				})
			in
				#"Changed Type"
