table orders_fact
	lineageTag: orders_fact-table

	column order_line_id
		dataType: int64
		summarizeBy: none
		sourceColumn: order_line_id

	column order_id
		dataType: string
		summarizeBy: none
		sourceColumn: order_id

	column customer_id
		dataType: string
		summarizeBy: none
		sourceColumn: customer_id

	column product_id
		dataType: string
		summarizeBy: none
		sourceColumn: product_id

	column order_date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: order_date

	column quantity
		dataType: int64
		summarizeBy: sum
		sourceColumn: quantity

	column price
		dataType: double
		summarizeBy: sum
		sourceColumn: price

	column freight
		dataType: double
		summarizeBy: sum
		sourceColumn: freight

	column amount
		dataType: double
		summarizeBy: sum
		sourceColumn: amount

	column payment_type
		dataType: string
		summarizeBy: none
		sourceColumn: payment_type

	column order_status
		dataType: string
		summarizeBy: none
		sourceColumn: order_status

	partition orders_fact = m
		mode: import
		source =
			let
				Source = Csv.Document(
					File.Contents(#"Data Folder" & "/orders_fact.csv"),
					[Delimiter = ",", Columns = 11, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				),
				#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				#"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {
					{"order_line_id", Int64.Type},
				{"order_id", Text.Type},
				{"customer_id", Text.Type},
				{"product_id", Text.Type},
				{"order_date", DateTime.Type},
				{"quantity", Int64.Type},
				{"price", Number.Type},
				{"freight", Number.Type},
				{"amount", Number.Type},
				{"payment_type", Text.Type},
				{"order_status", Text.Type}
				})
			in
				#"Changed Type"
